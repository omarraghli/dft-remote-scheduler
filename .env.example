# Only needed to point the app at a database other than the one in docker-compose.yml.
# Locally you do not need any of this: the defaults in application.yml already match compose.
#
# Any real deployment must set all three — the local defaults are published in this repo.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/dft_remote
SPRING_DATASOURCE_USERNAME=dft_remote
SPRING_DATASOURCE_PASSWORD=change-me
